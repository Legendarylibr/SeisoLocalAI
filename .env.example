# Seiso Forge — copy to .env and adjust. Defaults are secure/local-first.
SEISO_HOST=127.0.0.1
SEISO_PORT=8765
SEISO_DATA_DIR=~/.seiso
SEISO_SECRET_KEY=          # auto-generated on first run if empty
SEISO_ALLOW_REMOTE=false   # bind localhost only unless true
# Required when SEISO_ALLOW_REMOTE=true:
# SEISO_REMOTE_ACK=1
# Required when remote + tools/code-exec/openai-tools:
# SEISO_REMOTE_DANGEROUS_ACK=1
# HTTPS reverse proxy (see deploy/ and docs/deployment/reverse-proxy.md):
# SEISO_TRUST_PROXY=true
# SEISO_TRUSTED_PROXY_IPS=127.0.0.1,::1
# SEISO_SECURE_COOKIES=true
# SEISO_CORS_ORIGINS=   # optional — local defaults cover Forge :8765 and Vite :5173
SEISO_HF_TOKEN=            # optional Hugging Face token (gated models + faster auth)
# SEISO_INFERENCE_API_KEY= # optional override; auto-generated at ~/.seiso/.inference_api_key

# Hugging Face download speed (optional — see Settings → Hugging Face Hub)
# HUGGINGFACE_HUB_CACHE=/fast/nvme/hf_cache   # put cache on a fast local disk
# HF_XET_HIGH_PERFORMANCE=1                    # max throughput with hf-xet (fast links)
# HF_HUB_NUM_THREADS=12                        # parallel shard downloads (safetensors)
# HF_HUB_DOWNLOAD_TIMEOUT=600                  # seconds per file (large GGUF files)
SEISO_RATE_LIMIT=120       # requests/minute per IP (only when SEISO_ALLOW_REMOTE=true)
SEISO_SESSION_HOURS=24

SEISO_DB_EPHEMERIC=true       # in-memory SQLite; zero retention on restart (default)
# SEISO_DB_EPHEMERIC=false    # persist forge.db to disk (opt-in)
# SEISO_DB_STORAGE_MODE=persistent|ephemeral
# SEISO_DB_ENCRYPTION_KEY=    # optional 32-byte key (base64/hex); auto-generated per session when ephemeral

# --- Storage profiles (pick one data dir + DB mode) ---
# Daily use (~/.seiso): SEISO_DB_EPHEMERIC=false — chat history and jobs survive restart
# Dev / minimal RAM (.seiso-dev): SEISO_DB_EPHEMERAL=true — lowest DB footprint, re-onboard after restart
# Only one Forge can bind 127.0.0.1:8765 at a time (see docs/forge.md).

# Lean RAM profile (optional — all platforms; frees headroom for larger models)
# SEISO_MEMORY_PROFILE=low
# SEISO_LLAMA_PROMPT_CACHE=false
# SEISO_LLAMA_CACHE_MB=0
# Native Linux NVIDIA ignores SEISO_LLAMA_BATCH / SEISO_LLAMA_UBATCH — batches are VRAM-derived.
# SEISO_LLAMA_BATCH=256
# SEISO_LLAMA_UBATCH=128
# SEISO_SKIP_MLX_PROBE=1            # macOS only: skip MLX probe when using GGUF + llama.cpp

# Memory / llama.cpp tuning (optional — applied at Forge startup when unset)
# SEISO_LLAMA_DYNAMIC_CTX=true
# SEISO_LLAMA_USE_MMAP=true
# SEISO_LLAMA_USE_MLOCK=false
# SEISO_LLAMA_GPU_LAYERS=-1         # 0 for CPU-only
# SEISO_LLAMA_THREADS=4
# SEISO_INFERENCE_PROFILE=interactive  # safe | interactive | throughput (seeds defaults; explicit env wins)
# SEISO_STREAM_BATCH_CHARS=4        # SSE batch after 1st token (default 4; raise to 16 to cut SSE traffic)
# SEISO_TORCH_KV_STREAM=1           # cooperative torch decode with past_key_values (fallback: HF streamer)
# SEISO_LLAMA_PROMPT_LOOKUP=0       # opt-in llama.cpp n-gram speculative (LlamaPromptLookupDecoding)
# SEISO_LLAMA_PROMPT_LOOKUP_TOKENS=8
# SEISO_ALLOW_MEMORY_OVERCOMMIT=0   # allow preload past fit check (not recommended)
# HUGGINGFACE_HUB_CACHE defaults to {SEISO_DATA_DIR}/hf_cache (see seiso/models/hf_env.py)

# llama-swap sidecar — native Linux NVIDIA defaults to Ollama-first isolated GGUF chat.
# linux-nvidia bootstrap installs Ollama; start auto-starts it. llama-swap is optional fallback.
# SEISO_REQUIRE_SIDECAR=1           # seeded by linux-nvidia bootstrap; fail start when sidecar missing
# SEISO_SKIP_OLLAMA_INSTALL=1         # skip official Ollama installer during bootstrap
# SEISO_SIDECAR_OPTIONAL=1            # warn instead of hard-fail when sidecar missing
# SEISO_SIDECAR_AUTOSTART=1
# SEISO_LLAMASWAP_ENABLED=true
# SEISO_LLAMASWAP_URL=http://127.0.0.1:8080
# SEISO_LLAMASWAP_ENGINE=           # auto | llamacpp | ollama
# SEISO_LLAMASWAP_CONFIG=           # optional path passed to llama-swap --config
# SEISO_OLLAMA_URL=http://127.0.0.1:11434
# SEISO_LLAMASWAP_MODEL=            # optional model key when llama-swap config does not use the GGUF path
# SEISO_LLAMASWAP_API_KEY=          # optional local sidecar auth
# SEISO_OLLAMA_NUM_GPU=             # unset/auto for GPU; set a positive layer count to cap offload
# SEISO_OLLAMA_GPU_LAYER_RATIO=     # optional hard cap; default planner sizes offload from VRAM + model/KV footprint
# SEISO_OLLAMA_NUM_BATCH=           # override adaptive prefill batch; native NVIDIA auto: 128/256/512
# SEISO_OLLAMA_KEEP_ALIVE=          # override adaptive Ollama residency; native NVIDIA auto: 30s/1m/2m
# SEISO_SIDECAR_NUM_CTX=            # pin sidecar context window; default auto-sizes to prompt+response
# SEISO_SIDECAR_VRAM_BUDGET_RATIO=  # override free-VRAM ratio for Ollama sidecar offload
# SEISO_SIDECAR_VRAM_RESERVE_MB=    # hard VRAM margin kept free before sidecar offload planning
# SEISO_SIDECAR_PERF_MODE=1         # opt-in: higher VRAM ratio, larger num_batch, longer keep_alive
# SEISO_LLAMASWAP_SEND_NUM_CTX=1    # opt-in: attach n_ctx hint on llama-swap OpenAI requests
# OLLAMA_FLASH_ATTENTION=1          # start scripts seed these long-context defaults for ollama serve
# OLLAMA_KV_CACHE_TYPE=q8_0         # quantized KV halves cache memory vs f16
# OLLAMA_NUM_PARALLEL=1             # one slot keeps the full context budget for a single chat
# OLLAMA_MAX_LOADED_MODELS=1        # prevent multiple resident Ollama models from stacking VRAM

# Smart Router — optional external local router service in Chat
# Run https://github.com/Legendarylibr/SeisoModelRouter or a compatible service separately.
# SEISO_MODEL_ROUTER_ENABLED=true
# SEISO_MODEL_ROUTER_URL=http://127.0.0.1:8780
# SEISO_MODEL_ROUTER_API_KEY=   # optional when the external router requires API keys

# Linux NVIDIA GPU training — approve secure boundary before LoRA/QLoRA (see docs/platforms/linux-nvidia.md)
# SEISO_NVIDIA_HOST_VENV_ACK=1
# SEISO_NVIDIA_WSL_ACK=1
