# Seiso Forge — copy to .env and adjust. Defaults are secure/local-first.
SEISO_HOST=127.0.0.1
SEISO_PORT=8765
SEISO_DATA_DIR=~/.seiso
SEISO_SECRET_KEY=          # auto-generated on first run if empty
SEISO_ALLOW_REMOTE=false   # bind localhost only unless true
# Required when SEISO_ALLOW_REMOTE=true:
# SEISO_REMOTE_ACK=1
# Required when remote + tools/code-exec/openai-tools:
# SEISO_REMOTE_DANGEROUS_ACK=1
# HTTPS reverse proxy (see deploy/ and docs/deployment/reverse-proxy.md):
# SEISO_TRUST_PROXY=true
# SEISO_TRUSTED_PROXY_IPS=127.0.0.1,::1
# SEISO_SECURE_COOKIES=true
# SEISO_CORS_ORIGINS=https://forge.example.com
SEISO_CORS_ORIGINS=http://127.0.0.1:8765,http://localhost:5173
SEISO_HF_TOKEN=            # optional Hugging Face token (gated models + faster auth)
# SEISO_INFERENCE_API_KEY= # optional override; auto-generated at ~/.seiso/.inference_api_key

# Hugging Face download speed (optional — see Settings → Hugging Face Hub)
# HUGGINGFACE_HUB_CACHE=/fast/nvme/hf_cache   # put cache on a fast local disk
# HF_XET_HIGH_PERFORMANCE=1                    # max throughput with hf-xet (fast links)
# HF_HUB_NUM_THREADS=12                        # parallel shard downloads (safetensors)
# HF_HUB_DOWNLOAD_TIMEOUT=600                  # seconds per file (large GGUF files)
SEISO_RATE_LIMIT=120       # requests/minute per IP (only when SEISO_ALLOW_REMOTE=true)
SEISO_SESSION_HOURS=24

SEISO_DB_EPHEMERIC=true       # in-memory SQLite; zero retention on restart (default)
# SEISO_DB_EPHEMERIC=false    # persist forge.db to disk (opt-in)
# SEISO_DB_ENCRYPTION_KEY=    # optional 32-byte key (base64/hex); auto-generated per session when ephemeral

# Linux NVIDIA GPU training — approve secure boundary before LoRA/QLoRA (see docs/platforms/linux-nvidia.md)
# SEISO_NVIDIA_HOST_VENV_ACK=1
# SEISO_NVIDIA_WSL_ACK=1
