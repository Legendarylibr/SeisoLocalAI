# Seiso Forge — HTTPS reverse proxy deployment
#
# Copy to your .env (or merge with existing) when terminating TLS in front of Forge.
# Forge stays on localhost; the proxy handles HTTPS and public exposure.

SEISO_HOST=127.0.0.1
SEISO_PORT=8765
SEISO_ALLOW_REMOTE=false
SEISO_TRUST_PROXY=true
SEISO_TRUSTED_PROXY_IPS=127.0.0.1,::1
SEISO_SECURE_COOKIES=true
SEISO_CORS_ORIGINS=https://forge.example.com

# Strong secret (auto-generated on first run if empty)
# SEISO_SECRET_KEY=

# Optional: persist sessions across restarts
# SEISO_DB_EPHEMERAL=false

# --- Only if exposing Forge directly on LAN/WAN (no reverse proxy) ---
# SEISO_ALLOW_REMOTE=true
# SEISO_REMOTE_ACK=1
# SEISO_HOST=0.0.0.0
# SEISO_CORS_ORIGINS=https://192.168.1.10:8765
