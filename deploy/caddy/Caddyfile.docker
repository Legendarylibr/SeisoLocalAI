# Docker Compose variant — proxy to Forge on the host (not inside the container).
# Used by deploy/docker-compose.caddy.yml

forge.example.com {
	encode gzip

	reverse_proxy host.docker.internal:8765 {
		flush_interval -1
		transport http {
			read_timeout 24h
			write_timeout 24h
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
