{"benchmark": "code", "difficulty": "hard", "eval_seed": 10007, "held_out": true, "prompt": "Write `merge_sorted_g1(a, b)` merging two sorted ascending int lists.", "prompt_id": "eval_merge_sorted_hard_10007_1", "solution": "def merge_sorted_g1(a, b):\n    i = j = 0\n    out = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i])\n            i += 1\n        else:\n            out.append(b[j])\n            j += 1\n    out.extend(a[i:])\n    out.extend(b[j:])\n    return out\n", "synth": true, "synth_version": 2, "tags": ["algo", "list", "hard", "generated", "merge_sorted", "corpus"], "tests": ["assert merge_sorted_g1([4, 13], [0, 10, 12]) == [0, 4, 10, 12, 13]", "assert merge_sorted_g1([0, 3, 6, 8], [6, 8, 8, 14]) == [0, 3, 6, 6, 8, 8, 8, 14]", "assert merge_sorted_g1([1, 5, 11], [0, 2, 3, 5, 9]) == [0, 1, 2, 3, 5, 5, 9, 11]", "assert merge_sorted_g1([1, 4, 5, 11, 13], [1]) == [1, 1, 4, 5, 11, 13]"], "timeout_s": 4.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `digit_count_g2(n)` for integers implementing `digit_count`.", "prompt_id": "eval_digit_ops_medium_10007_2", "solution": "def digit_count_g2(n):\n    n = abs(n)\n    if n == 0:\n        return 1\n    c = 0\n    while n:\n        c += 1\n        n //= 10\n    return c\n", "synth": true, "synth_version": 2, "tags": ["math", "medium", "generated", "digit_ops", "corpus"], "tests": ["assert digit_count_g2(-4050) == 4", "assert digit_count_g2(-1229) == 4", "assert digit_count_g2(233) == 3", "assert digit_count_g2(8346) == 4", "assert digit_count_g2(9889) == 4", "assert digit_count_g2(0) == 1"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "easy", "eval_seed": 10007, "held_out": true, "prompt": "Write a pure Python function `sub_g3(a, b)` implementing integer binary op `a - b` (return 0 when dividing/modding by zero).", "prompt_id": "eval_binop_easy_10007_3", "solution": "def sub_g3(a, b):\n    return a - b\n", "synth": true, "synth_version": 2, "tags": ["arith", "easy", "generated", "binop", "corpus"], "tests": ["assert sub_g3(-8, 10) == -18", "assert sub_g3(34, -8) == 42", "assert sub_g3(26, -3) == 29", "assert sub_g3(24, 9) == 15", "assert sub_g3(0, 12) == -12", "assert sub_g3(0, 1) == -1"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `valid_parens_g4(s)` True iff parentheses in s are balanced.", "prompt_id": "eval_parens_medium_10007_4", "solution": "def valid_parens_g4(s):\n    depth = 0\n    for ch in s:\n        if ch == '(':\n            depth += 1\n        elif ch == ')':\n            depth -= 1\n            if depth < 0:\n                return False\n    return depth == 0\n", "synth": true, "synth_version": 2, "tags": ["string", "stack", "medium", "generated", "parens", "corpus"], "tests": ["assert valid_parens_g4('()') is True", "assert valid_parens_g4('(())') is True", "assert valid_parens_g4('(()') is False", "assert valid_parens_g4(')(') is False", "assert valid_parens_g4('') is True", "assert valid_parens_g4('()()') is True", "assert valid_parens_g4('())(') is False", "assert valid_parens_g4('(()())') is True"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "easy", "eval_seed": 10007, "held_out": true, "prompt": "Write a pure Python function `floordiv_g5(a, b)` implementing integer binary op `a // b if b != 0 else 0` (return 0 when dividing/modding by zero).", "prompt_id": "eval_binop_easy_10007_5", "solution": "def floordiv_g5(a, b):\n    return a // b if b != 0 else 0\n", "synth": true, "synth_version": 2, "tags": ["arith", "easy", "generated", "binop", "corpus"], "tests": ["assert floordiv_g5(19, 3) == 6", "assert floordiv_g5(35, -10) == -4", "assert floordiv_g5(-20, 8) == -3", "assert floordiv_g5(34, 9) == 3", "assert floordiv_g5(12, 14) == 0", "assert floordiv_g5(0, 1) == 0"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `rotate_left_g6(items, k)` left-rotate list by k (mod len).", "prompt_id": "eval_rotate_medium_10007_6", "solution": "def rotate_left_g6(items, k):\n    if not items:\n        return []\n    n = len(items)\n    k = k % n\n    return items[k:] + items[:k]\n", "synth": true, "synth_version": 2, "tags": ["list", "medium", "generated", "rotate", "corpus"], "tests": ["assert rotate_left_g6([1, 4, 7], 6) == [1, 4, 7]", "assert rotate_left_g6([1], 3) == [1]", "assert rotate_left_g6([2, 7, 0, 7], 8) == [2, 7, 0, 7]", "assert rotate_left_g6([8, 7, 9], 6) == [8, 7, 9]", "assert rotate_left_g6([], 3) == []"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "hard", "eval_seed": 10007, "held_out": true, "prompt": "Implement a small module with helpers and public `summarize_g7(nums, lo=0, hi=100)` returning {'count', 'mean', 'max'} where mean is clamped into [lo, hi]. Empty input → count 0, mean 0, max None. Pure Python only.", "prompt_id": "eval_mini_stats_hard_10007_7", "solution": "def _mean_7(nums):\n    if not nums:\n        return 0\n    return sum(nums) / len(nums)\n\ndef _clamp_7(x, lo, hi):\n    if x < lo:\n        return lo\n    if x > hi:\n        return hi\n    return x\n\ndef summarize_g7(nums, lo=0, hi=100):\n    \"\"\"Return dict with count, mean (clamped into [lo,hi]), and max.\"\"\"\n    if not nums:\n        return {'count': 0, 'mean': 0, 'max': None}\n    m = _mean_7(nums)\n    return {\n        'count': len(nums),\n        'mean': _clamp_7(m, lo, hi),\n        'max': max(nums),\n    }\n", "synth": true, "synth_version": 2, "tags": ["codebase", "dict", "hard", "generated", "mini_stats", "corpus"], "tests": ["assert summarize_g7([-4, 1], 0, 20) == {'count': 2, 'mean': 0, 'max': 1}", "assert summarize_g7([], 0, 20) == {'count': 0, 'mean': 0, 'max': None}", "assert summarize_g7([9, 12, 13, 36, 30, 30], 0, 20) == {'count': 6, 'mean': 20, 'max': 36}", "assert summarize_g7([35, 27, 40, 15, 2, -2], 0, 20) == {'count': 6, 'mean': 19.5, 'max': 40}", "assert summarize_g7([]) == {'count': 0, 'mean': 0, 'max': None}"], "timeout_s": 4.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `unique_preserve_g8(items)` unique values preserving first-seen order.", "prompt_id": "eval_unique_order_medium_10007_8", "solution": "def unique_preserve_g8(items):\n    seen = set()\n    out = []\n    for x in items:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out\n", "synth": true, "synth_version": 2, "tags": ["list", "medium", "generated", "unique_order", "corpus"], "tests": ["assert unique_preserve_g8([4, 3, 5, 0, 4, 5]) == [4, 3, 5, 0]", "assert unique_preserve_g8([3, 6, 3, 5]) == [3, 6, 5]", "assert unique_preserve_g8([4, 4, 0, 6, 2, 2, 4, 3]) == [4, 0, 6, 2, 3]", "assert unique_preserve_g8([6, 6, 6, 4, 5, 4]) == [6, 4, 5]", "assert unique_preserve_g8([]) == []"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "hard", "eval_seed": 10007, "held_out": true, "prompt": "Write `flatten_g9(matrix)` row-major flatten of list[list[int]].", "prompt_id": "eval_flatten_hard_10007_9", "solution": "def flatten_g9(matrix):\n    out = []\n    for row in matrix:\n        for x in row:\n            out.append(x)\n    return out\n", "synth": true, "synth_version": 2, "tags": ["list", "hard", "generated", "flatten", "corpus"], "tests": ["assert flatten_g9([[5, 5, 2], [3, 3]]) == [5, 5, 2, 3, 3]", "assert flatten_g9([[]]) == []", "assert flatten_g9([[6, 4, 4, 6], [8, 7]]) == [6, 4, 4, 6, 8, 7]", "assert flatten_g9([[1, 3, 1], [8, 6, 5, 5], [0, 0, 4, 5]]) == [1, 3, 1, 8, 6, 5, 5, 0, 0, 4, 5]", "assert flatten_g9([]) == []"], "timeout_s": 4.0}
