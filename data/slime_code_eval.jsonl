{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `digit_count_g18(n)` for integers implementing `digit_count`.", "prompt_id": "eval_digit_ops_medium_10007_18", "solution": "def digit_count_g18(n):\n    n = abs(n)\n    if n == 0:\n        return 1\n    c = 0\n    while n:\n        c += 1\n        n //= 10\n    return c\n", "synth": true, "synth_version": 2, "tags": ["math", "medium", "generated", "digit_ops", "corpus"], "tests": ["assert digit_count_g18(-1658) == 4", "assert digit_count_g18(-9765) == 4", "assert digit_count_g18(-9981) == 4", "assert digit_count_g18(-8328) == 4", "assert digit_count_g18(-33) == 2", "assert digit_count_g18(0) == 1"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `running_sum_g19(nums)` returning prefix sums.", "prompt_id": "eval_running_sum_medium_10007_19", "solution": "def running_sum_g19(nums):\n    out = []\n    total = 0\n    for x in nums:\n        total += x\n        out.append(total)\n    return out\n", "synth": true, "synth_version": 2, "tags": ["list", "medium", "generated", "running_sum", "corpus"], "tests": ["assert running_sum_g19([15]) == [15]", "assert running_sum_g19([9, 19, 12, 17, 9]) == [9, 28, 40, 57, 66]", "assert running_sum_g19([11]) == [11]", "assert running_sum_g19([5, 17, 6, 15]) == [5, 22, 28, 43]", "assert running_sum_g19([]) == []"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `gcd_g20(a, b)` computing non-negative gcd.", "prompt_id": "eval_gcd_lcm_medium_10007_20", "solution": "def gcd_g20(a, b):\n    a, b = abs(a), abs(b)\n    while b:\n        a, b = b, a % b\n    return a\n", "synth": true, "synth_version": 2, "tags": ["math", "medium", "generated", "gcd_lcm", "corpus"], "tests": ["assert gcd_g20(30, 6) == 6", "assert gcd_g20(20, 29) == 1", "assert gcd_g20(28, 29) == 1", "assert gcd_g20(18, 28) == 2", "assert gcd_g20(29, 5) == 1"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `unique_preserve_g21(items)` unique values preserving first-seen order.", "prompt_id": "eval_unique_order_medium_10007_21", "solution": "def unique_preserve_g21(items):\n    seen = set()\n    out = []\n    for x in items:\n        if x not in seen:\n            seen.add(x)\n            out.append(x)\n    return out\n", "synth": true, "synth_version": 2, "tags": ["list", "medium", "generated", "unique_order", "corpus"], "tests": ["assert unique_preserve_g21([4, 3, 4]) == [4, 3]", "assert unique_preserve_g21([5, 3, 3, 6, 0, 5, 5, 6]) == [5, 3, 6, 0]", "assert unique_preserve_g21([0, 4, 1]) == [0, 4, 1]", "assert unique_preserve_g21([3, 5, 6, 3, 5]) == [3, 5, 6]", "assert unique_preserve_g21([]) == []"], "timeout_s": 3.0}
{"benchmark": "code", "difficulty": "hard", "eval_seed": 10007, "held_out": true, "prompt": "Implement helpers plus `normalize_tokens_g22(text, unique=True)` that lowercases, splits on whitespace, and optionally de-duplicates preserving order.", "prompt_id": "eval_mini_text_hard_10007_22", "solution": "def _split_words_22(text):\n    return [w for w in text.lower().split() if w]\n\ndef _dedupe_22(words):\n    seen = set()\n    out = []\n    for w in words:\n        if w not in seen:\n            seen.add(w)\n            out.append(w)\n    return out\n\ndef normalize_tokens_g22(text, unique=True):\n    words = _split_words_22(text)\n    if unique:\n        words = _dedupe_22(words)\n    return words\n", "synth": true, "synth_version": 2, "tags": ["codebase", "string", "hard", "generated", "mini_text", "corpus"], "tests": ["assert normalize_tokens_g22('Hello Hello World', True) == ['hello', 'world']", "assert normalize_tokens_g22('Hello Hello World', False) == ['hello', 'hello', 'world']", "assert normalize_tokens_g22('  A b A  ', True) == ['a', 'b']", "assert normalize_tokens_g22('  A b A  ', False) == ['a', 'b', 'a']", "assert normalize_tokens_g22('', True) == []", "assert normalize_tokens_g22('', False) == []", "assert normalize_tokens_g22('Python PYTHON python', True) == ['python']", "assert normalize_tokens_g22('Python PYTHON python', False) == ['python', 'python', 'python']", "assert normalize_tokens_g22('uvlezlrvlm', True) == ['uvlezlrvlm']", "assert normalize_tokens_g22('uvlezlrvlm', False) == ['uvlezlrvlm']"], "timeout_s": 4.0}
