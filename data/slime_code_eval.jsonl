{"benchmark": "code", "difficulty": "hard", "eval_seed": 10007, "held_out": true, "prompt": "Write `merge_sorted_g25(a, b)` merging two sorted ascending int lists.", "prompt_id": "eval_merge_sorted_hard_10007_25", "solution": "def merge_sorted_g25(a, b):\n    i = j = 0\n    out = []\n    while i < len(a) and j < len(b):\n        if a[i] <= b[j]:\n            out.append(a[i])\n            i += 1\n        else:\n            out.append(b[j])\n            j += 1\n    out.extend(a[i:])\n    out.extend(b[j:])\n    return out\n", "synth": true, "synth_version": 2, "tags": ["algo", "list", "hard", "generated", "merge_sorted", "corpus"], "tests": ["assert merge_sorted_g25([9, 11, 12, 14], []) == [9, 11, 12, 14]", "assert merge_sorted_g25([9, 14], [15]) == [9, 14, 15]", "assert merge_sorted_g25([1, 5, 9, 11, 12], [0, 1, 3, 10, 14]) == [0, 1, 1, 3, 5, 9, 10, 11, 12, 14]", "assert merge_sorted_g25([], [2, 2]) == [2, 2]"], "timeout_s": 4.0}
