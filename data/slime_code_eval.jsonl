{"benchmark": "code", "difficulty": "easy", "eval_seed": 10007, "held_out": true, "prompt": "Write `clamp_g15(x, lo, hi)` clamping x into [lo, hi] (swap if lo>hi).", "prompt_id": "eval_clamp_easy_10007_15", "solution": "def clamp_g15(x, lo, hi):\n    if lo > hi:\n        lo, hi = hi, lo\n    if x < lo:\n        return lo\n    if x > hi:\n        return hi\n    return x\n", "synth": true, "synth_version": 2, "tags": ["arith", "easy", "generated", "clamp", "corpus"], "tests": ["assert clamp_g15(19, 0, 17) == 17", "assert clamp_g15(6, 9, 14) == 9", "assert clamp_g15(-7, 4, 11) == 4", "assert clamp_g15(4, 8, 10) == 8", "assert clamp_g15(0, 1, 5) == 1"], "timeout_s": 3.0}
