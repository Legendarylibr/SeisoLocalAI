{"benchmark": "code", "difficulty": "medium", "eval_seed": 10007, "held_out": true, "prompt": "Write `char_count_g13(s)` returning a dict of character counts.", "prompt_id": "eval_dict_count_medium_10007_13", "solution": "def char_count_g13(s):\n    out = {}\n    for ch in s:\n        out[ch] = out.get(ch, 0) + 1\n    return out\n", "synth": true, "synth_version": 2, "tags": ["dict", "medium", "generated", "dict_count", "corpus"], "tests": ["assert char_count_g13('aab') == {'a': 2, 'b': 1}", "assert char_count_g13('xyz') == {'x': 1, 'y': 1, 'z': 1}", "assert char_count_g13('') == {}", "assert char_count_g13('mississippi') == {'m': 1, 'i': 4, 's': 4, 'p': 2}", "assert char_count_g13('Aa') == {'A': 1, 'a': 1}", "assert char_count_g13('auaqo') == {'a': 2, 'u': 1, 'q': 1, 'o': 1}"], "timeout_s": 3.0}
