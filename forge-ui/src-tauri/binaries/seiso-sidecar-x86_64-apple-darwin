#!/usr/bin/env bash
# Seiso sidecar — spawned by the Tauri desktop app.
# Starts the Forge backend using the venv's seiso entrypoint directly
# (no sourcing of an environment-controlled activate script).
set -euo pipefail

INSTALL_DIR="${SEISO_INSTALL_DIR:-$HOME/Seiso}"
DATA_DIR="${SEISO_DATA_DIR:-$HOME/.seiso}"
PORT="${SEISO_PORT:-8765}"

# Refuse a non-absolute or missing install dir — never cd/source from an
# unexpected path.
case "$INSTALL_DIR" in
  /*) ;;
  *)
    echo "error: SEISO_INSTALL_DIR must be an absolute path (got '$INSTALL_DIR')" >&2
    exit 1
    ;;
esac

if [ ! -d "$INSTALL_DIR" ]; then
  echo "error: install dir does not exist: $INSTALL_DIR" >&2
  exit 1
fi

# The venv's console script carries the venv interpreter in its shebang, so it
# runs without sourcing activate.
SEISO="$INSTALL_DIR/.venv/bin/seiso"
if [ ! -x "$SEISO" ]; then
  echo "error: seiso CLI not found at $SEISO (is Seiso installed?)" >&2
  exit 1
fi

# Ensure SSH agent socket is forwarded to git operations
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
  export SSH_AUTH_SOCK
  echo "SSH_AUTH_SOCK forwarded: $SSH_AUTH_SOCK" >&2
fi

# Ensure gh CLI is on PATH
if command -v gh &>/dev/null; then
  echo "gh CLI available: $(gh --version 2>&1 | head -1)" >&2
fi

# Write a marker file so the Forge API knows it's running in desktop mode
mkdir -p "$DATA_DIR/desktop"
echo "desktop" > "$DATA_DIR/desktop/mode"

# Start Forge without opening a browser (Tauri is the UI)
# --no-open prevents the browser from launching
# --port matches what Tauri expects
exec "$SEISO" forge --no-open --port "$PORT" "$@"
